<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
  <persistence-unit name="ClothesShopPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>clothingstore.dto.CartItem</class>
    <class>clothingstore.dto.CategoryDTO</class>
    <class>clothingstore.dto.OrderDTO</class>
    <class>clothingstore.dto.OrderItemDTO</class>
    <class>clothingstore.dto.PaymentDTO</class>
    <class>clothingstore.dto.ProductDTO</class>
    <class>clothingstore.dto.SupplierDTO</class>
    <class>clothingstore.dto.TypeDTO</class>
    <class>clothingstore.dto.UserDTO</class>
    <class>clothingstore.dto.UserGoogleDTO</class>
    <class>clothingstore.dto.WalletDTO</class>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value=""/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.show_sql" value="true" />
    </properties>
  </persistence-unit>
</persistence>
